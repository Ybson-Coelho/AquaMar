{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/public/**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/(css|js|assets|img)/(.*)",
      "destination": "src/public/$1/$2"
    },
    {
      "source": "/(.*)",
      "destination": "src/server.js"
    }
  ]
}
